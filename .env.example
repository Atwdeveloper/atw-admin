# Copy to .env.local for local development.

# Java backend the browser calls directly (full base path, ending in /api/v1).
# Defaults to ADMIN_API_URL in src/api/adminApiUrl.js. The backend's CORS list
# must include the origin this app runs on (localhost in dev, the deployed domain).
# NEXT_PUBLIC_ADMIN_API_URL=https://api-dev.techagent.co.in/api/v1

# Old Laravel API, used only by the legacy admin screens below.
# NEXT_PUBLIC_API_URL=https://anytimework.in/anytimework/public/api/

# Turn on the admin screens that still call the old Laravel API (company,
# worker, reports, ...). Off until they move to the Java backend.
NEXT_PUBLIC_LEGACY_ADMIN_FEATURES=false
# Load site settings from the old Laravel API instead of the static defaults.
NEXT_PUBLIC_LEGACY_API_ENABLED=false

# Google reCAPTCHA v2 ("I'm not a robot" checkbox) site key for the admin login
# page. Leave unset to hide the captcha (e.g. local dev). The matching SECRET key
# belongs on the backend only, which must verify the token sent as
# `recaptchaToken` in POST /admin/auth/login.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Google Analytics measurement id (optional).
# NEXT_PUBLIC_GA_ID=G-NFVT7EHQXH
