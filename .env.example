# Copy to .env.local for local development.

# Where the browser sends Java backend calls (must end in /api/v1). Leave unset
# to go through this app's /api/v1 proxy route; set it only if the backend's
# CORS allows this app's domain.
# NEXT_PUBLIC_ADMIN_API_URL=https://api-dev.techagent.co.in/api/v1

# Where the /api/v1 proxy route (src/app/api/v1/[...path]/route.js) forwards to
# (full base path, ending in /api/v1). Defaults to ADMIN_API_URL in src/api/adminApiUrl.js.
# ADMIN_API_PROXY_TARGET=https://api-dev.techagent.co.in/api/v1

# Old Laravel API, used only by the legacy admin screens below.
# NEXT_PUBLIC_API_URL=https://anytimework.in/anytimework/public/api/

# Turn on the admin screens that still call the old Laravel API (company,
# worker, reports, ...). Off until they move to the Java backend.
NEXT_PUBLIC_LEGACY_ADMIN_FEATURES=false
# Load site settings from the old Laravel API instead of the static defaults.
NEXT_PUBLIC_LEGACY_API_ENABLED=false

# Google Analytics measurement id (optional).
# NEXT_PUBLIC_GA_ID=G-NFVT7EHQXH
